# LiteLLM routes to any provider via the ANTHROPIC/OPENAI/etc. API keys
# Set only the ones you use. Ollama needs no key.
# OpenAI-compatible: OPENAI_API_KEY=
# Anthropic: ANTHROPIC_API_KEY=
# Google: GEMINI_API_KEY=
# Groq: GROQ_API_KEY=
# Local: leave blank, use provider=ollama and model=ollama/llama3

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional live-exchange keys (unused in paper mode)
EXCHANGE_API_KEY=
EXCHANGE_SECRET=